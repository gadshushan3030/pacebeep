{
  "name": "pacebeep-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker start pacebeep-db 2>/dev/null || docker run -d --name pacebeep-db -p 55433:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=pacebeep -v pacebeep-db:/var/lib/postgresql/data postgres:17-alpine",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "vercel-build": "node scripts/migrate.mts && next build"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "^1.7.6",
    "@modelcontextprotocol/server": "^2.2.0",
    "better-auth": "^1.7.6",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
