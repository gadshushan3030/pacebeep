# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

# Postgres. Local: `npm run db:up` starts one on port 55433. Production: Neon.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/pacebeep

# Random 32+ byte secret for Better Auth: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL (production: https://<your-app>.vercel.app). Also defines the MCP resource <url>/mcp.
BETTER_AUTH_URL=http://localhost:3200

# Optional: set to "false" to close registration.
SIGNUP_ENABLED=true

# Optional: "Continue with Google". Create a Web OAuth client in Google Cloud with the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google. When set, new accounts come only from Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continue with Apple" (App Store guideline 4.8 asks for it next to Google). Apple Developer →
# Identifiers: a Services ID (APPLE_CLIENT_ID) with Sign in with Apple, domain <your-app> and return URL
# <BETTER_AUTH_URL>/api/auth/callback/apple; Keys: a key with Sign in with Apple (APPLE_KEY_ID, and the
# .p8 file's contents in APPLE_PRIVATE_KEY). APPLE_TEAM_ID is in Membership details.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
